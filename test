<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Anton+SC&family=Poppins:wght@300;400&display=swap');

        :root {
            --bg-gradient: linear-gradient(180deg, #110c0a 0%, #3d1b02 100%);
            --pill-bg: #1a1a1a;
            --orange: #ff5f00;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #000;
        }

        .footer-container {
            width: 100%;
            height: 450px;
            background: var(--bg-gradient);
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            font-family: 'Poppins', sans-serif;
        }

        .footer-content {
            position: relative;
            width: 100%;
            max-width: 1200px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* বড় টেক্সট স্টাইল */
        .hero-text {
            font-family: 'Anton SC', sans-serif;
            font-size: 150px;
            color: #fff;
            line-height: 1;
            text-transform: uppercase;
            letter-spacing: -2px;
            white-space: nowrap;
            user-select: none;
        }

        /* সেই বাঁকানো কালো পিল/ক্যাপসুল */
        .design-pill {
            position: absolute;
            background: #111;
            padding: 12px 40px;
            border-radius: 100px;
            border: 1px solid #333;
            transform: rotate(-12deg);
            /* ছবির মতো বাঁকানো */
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pill-text {
            color: var(--orange);
            font-family: 'Anton SC', sans-serif;
            font-size: 24px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* লিঙ্কগুলোর পজিশন (ডেক্সটপে উপরে ডানদিকে) */
        .footer-nav {
            position: absolute;
            top: -50px;
            right: 0;
            display: flex;
            gap: 30px;
        }

        .footer-link {
            text-decoration: none;
            color: rgba(255, 255, 255, 0.7);
            font-size: 14px;
            transition: 0.3s;
        }

        .footer-link:hover {
            color: #fff;
        }

        /* --- Responsive (Mobile) --- */
        @media (max-width: 1024px) {
            .hero-text {
                font-size: 100px;
            }

            .pill-text {
                font-size: 18px;
            }

            .footer-nav {
                top: -80px;
                right: 20px;
            }
        }

        @media (max-width: 768px) {
            .footer-container {
                height: 350px;
            }

            .hero-text {
                font-size: 60px;
            }

            .design-pill {
                padding: 8px 25px;
                transform: rotate(-10deg);
            }

            .pill-text {
                font-size: 14px;
            }

            .footer-nav {
                top: auto;
                bottom: -80px;
                right: auto;
                width: 100%;
                justify-content: center;
                gap: 15px;
            }
        }
    </style>
</head>

<body>

    <footer class="footer-container">
        <div class="footer-content">

            <h1 class="hero-text">SAYED HOSSAIN</h1>

            <div class="design-pill">
                <span class="pill-text">GRAPHIC & MOTION DESIGNER</span>
            </div>

            <nav class="footer-nav">
                <a href="#" class="footer-link">Home</a>
                <a href="#" class="footer-link">Projects</a>
                <a href="#" class="footer-link">Services</a>
                <a href="#" class="footer-link">Download CV</a>
            </nav>

        </div>
    </footer>

</body>

</html>




